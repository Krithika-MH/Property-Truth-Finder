# TinyFish configuration (Account MUST be created via the hackathon referral link)
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_MOCK=0
MAX_CONCURRENT_RUNS=3
INVESTIGATION_TIMEOUT_SECONDS=600

# LLM configuration (Google Gemini or Anthropic Claude)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=your_gemini_api_key_here

# Application settings
MANUAL_BASELINE_MINUTES=45
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8001
DATA_DIR=./data
